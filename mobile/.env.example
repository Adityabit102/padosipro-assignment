# Base URL of the PadosiPro API, baked into the app at build time.
# It can also be changed at runtime from the "Server" link on the Log in screen.
#   Android emulator -> http://10.0.2.2:4000   (the emulator's alias for your computer)
#   Real phone       -> http://<your computer's LAN IP>:4000, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
