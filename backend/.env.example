# Copy to .env for running the API outside Docker (npm run dev).
# docker compose sets these itself; see ../docker-compose.yml.
# All values below are local development placeholders, not real secrets.

NODE_ENV=development
PORT=4000

# Postgres from docker compose is published on host port 5433
DATABASE_URL=postgresql://padosipro:padosipro@localhost:5433/padosipro?schema=public

# Generate your own with: openssl rand -hex 32
JWT_SECRET=change-me-dev-jwt-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Key for hashing OTP codes (HMAC-SHA256). Generate with: openssl rand -hex 32
OTP_SECRET=change-me-dev-otp-secret-at-least-32-characters

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# Mailpit (local mail catcher from docker compose). Read the emails at http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="PadosiPro <no-reply@padosipro.local>"

AUTH_RATE_LIMIT_PER_15_MIN=50
LOG_LEVEL=info
